sigpp_m2 = Uniform(minimum=0, maximum=10)

delta_min_m2 = Uniform(minimum=0, maximum=10)
delta_max_m2 = Uniform(minimum=0, maximum=10)

lam_m2 = Uniform(minimum=0, maximum=1)

mmax_m2 = Uniform(minimum=20, maximum=150)

lamb = Uniform(minimum=-10, maximum=10)

